{
  "name": "ZS_theme",
  "dataColors": [
    "#2F5D46",
    "#A9C4A0",
    "#D9C7A3",
    "#555B57",
    "#6E9B7B",
    "#B79F72",
    "#8A948E"
  ],
  "background": "#F5EFE2",
  "foreground": "#555B57",
  "tableAccent": "#2F5D46",
  "good": "#2F5D46",
  "neutral": "#D9C7A3",
  "bad": "#B5533C",
  "minimum": "#B5533C",
  "center": "#D9C7A3",
  "maximum": "#2F5D46",
  "textClasses": {
    "callout": {
      "fontSize": 32,
      "fontFace": "DIN",
      "color": "#2F5D46"
    },
    "title": {
      "fontSize": 18,
      "fontFace": "DIN",
      "color": "#2F5D46"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "DIN",
      "color": "#555B57"
    },
    "label": {
      "fontSize": 12,
      "fontFace": "DIN",
      "color": "#555B57"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#2F5D46"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F5EFE2"
              }
            }
          }
        ]
      }
    },
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontSize": 18,
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#2F5D46"
              }
            },
            "alignment": "left"
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#F5EFE2"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#F5EFE2"
              }
            },
            "radius": 10
          }
        ],
        "legend": [
          {
            "fontSize": 12,
            "labelColor": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "fontSize": 12,
            "labelColor": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "fontSize": 12,
            "labelColor": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ],
        "labels": [
          {
            "fontSize": 12,
            "color": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 32,
            "bold": true,
            "color": {
              "solid": {
                "color": "#2F5D46"
              }
            }
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "fontSize": 32,
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#2F5D46"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ],
        "values": [
          {
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ],
        "grid": [
          {
            "gridVertical": true,
            "gridVerticalColor": {
              "solid": {
                "color": "#E7DBC3"
              }
            },
            "gridVerticalWeight": 2
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ],
        "rowHeaders": [
          {
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ],
        "values": [
          {
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ],
        "grid": [
          {
            "gridVertical": true,
            "gridVerticalColor": {
              "solid": {
                "color": "#E7DBC3"
              }
            },
            "gridVerticalWeight": 2
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "text": [
          {
            "fontSize": 16,
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#F5EFE2"
              }
            }
          }
        ],
        "fill": [
          {
            "$id": "default",
            "fillColor": {
              "solid": {
                "color": "#2F5D46"
              }
            },
            "transparency": 0
          },
          {
            "$id": "hover",
            "fillColor": {
              "solid": {
                "color": "#3E7358"
              }
            },
            "transparency": 0
          },
          {
            "$id": "selected",
            "fillColor": {
              "solid": {
                "color": "#3E7358"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "labelPosition": "OutsideEnd",
            "fontSize": 12,
            "color": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "fontSize": 12,
            "labelColor": {
              "solid": {
                "color": "#555B57"
              }
            },
            "innerPadding": 20
          }
        ],
        "valueAxis": [
          {
            "fontSize": 12,
            "labelColor": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "labelPosition": "OutsideEnd",
            "fontSize": 12,
            "color": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "fontSize": 12,
            "labelColor": {
              "solid": {
                "color": "#555B57"
              }
            },
            "innerPadding": 20
          }
        ],
        "valueAxis": [
          {
            "fontSize": 12,
            "labelColor": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "categoryAxis": [
          {
            "fontSize": 12,
            "labelColor": {
              "solid": {
                "color": "#555B57"
              }
            },
            "innerPadding": 20
          }
        ],
        "valueAxis": [
          {
            "fontSize": 12,
            "labelColor": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [
          {
            "fontSize": 12,
            "labelColor": {
              "solid": {
                "color": "#555B57"
              }
            },
            "innerPadding": 20
          }
        ],
        "valueAxis": [
          {
            "fontSize": 12,
            "labelColor": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [
          {
            "fontSize": 12,
            "labelColor": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "fontSize": 12,
            "labelColor": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ]
      }
    },
    "areaChart": {
      "*": {
        "categoryAxis": [
          {
            "fontSize": 12,
            "labelColor": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "fontSize": 12,
            "labelColor": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "categoryAxis": [
          {
            "fontSize": 12,
            "labelColor": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "fontSize": 12,
            "labelColor": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#555B57"
              }
            }
          }
        ]
      }
    }
  }
}